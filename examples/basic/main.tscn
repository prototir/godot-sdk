[gd_scene load_steps=2 format=3]

[ext_resource path="res://examples/basic/main.gd" type="Script" id="1"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Panel" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 32.0
offset_top = 32.0
offset_right = 480.0
offset_bottom = 220.0
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Panel"]
layout_mode = 2
text = "Prototir Godot SDK"

[node name="Status" type="Label" parent="Panel"]
layout_mode = 2
text = "Starting..."

[node name="AddPoint" type="Button" parent="Panel"]
layout_mode = 2
text = "Add point"

[connection signal="pressed" from="Panel/AddPoint" to="." method="_on_add_point_pressed"]
